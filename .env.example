# ==========================================================
# BIZMATE — Environment Variables (CONTOH)
# ==========================================================
# Salin file ini menjadi ".env.local" lalu isi nilainya.
# .env.local TIDAK di-commit ke Git (sudah ada di .gitignore).
#
# Untuk TAHAP 1 semua variabel ini belum wajib.
# Isi mulai TAHAP 2 (Supabase) dan TAHAP 4-5 (LLM & OCR).
# ==========================================================

# --- Supabase (Tahap 2) ---
# Dapatkan di: Supabase Dashboard → Project Settings → API
# Kunci "anon public" aman untuk browser; service role key JANGAN pernah di sini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (jangan pernah diawali NEXT_PUBLIC_, jangan diekspos ke browser)
# SUPABASE_SERVICE_ROLE_KEY=

# --- LLM API untuk AI Assistant (Tahap 4) ---
# Contoh penyedia: OpenAI / Anthropic / Google AI Studio
# LLM_API_KEY=
# LLM_API_BASE_URL=

# --- OCR / Receipt Scanner (Tahap 5) ---
# Jika kosong, aplikasi berjalan dalam MOCK MODE yang diberi label jelas.
# OCR_API_KEY=
