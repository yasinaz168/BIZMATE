# ==========================================================
# BIZMATE — Environment Variables (CONTOH)
# ==========================================================
# Salin file ini menjadi ".env.local" lalu isi nilainya.
# .env.local TIDAK di-commit ke Git (sudah ada di .gitignore).
#
# Untuk TAHAP 1 semua variabel ini belum wajib.
# Isi mulai TAHAP 2 (Supabase) dan TAHAP 4-5 (LLM & OCR).
# ==========================================================

# --- Supabase (Tahap 2) ---
# Dapatkan di: Supabase Dashboard → Project Settings → API Keys
# Publishable key aman untuk browser; secret/service role key JANGAN pernah di sini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nama lama (opsional) — masih dibaca sebagai fallback bila variabel di atas kosong.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (jangan pernah diawali NEXT_PUBLIC_, jangan diekspos ke browser)
# SUPABASE_SERVICE_ROLE_KEY=

# --- LLM API untuk AI Assistant (Tahap 4) ---
# WAJIB format kompatibel OpenAI (/chat/completions).
# Contoh:
#   OpenAI : LLM_API_BASE_URL=https://api.openai.com/v1
#   Groq   : LLM_API_BASE_URL=https://api.groq.com/openai/v1  (model mis. llama-3.1-8b-instant)
#   OpenRouter: LLM_API_BASE_URL=https://openrouter.ai/api/v1
# Jika LLM_API_KEY kosong → aplikasi memakai MODE SIMULASI berlabel jelas (bukan AI sungguhan).
# LLM_API_KEY=
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- OCR / Receipt Scanner (Tahap 5) ---
# Jika kosong, aplikasi berjalan dalam MOCK MODE yang diberi label jelas.
# OCR_API_KEY=
#
# --- Google Cloud Vision (opsional — Tahap integrasi OCR) ---
# Pilih provider OCR: "mock" (default, simulasi berlabel) atau "google-vision".
# OCR_PROVIDER=mock
#
# Kredensial Google Cloud — SERVER-ONLY (jangan pernah diawali NEXT_PUBLIC_,
# jangan pernah dikirim ke browser, jangan pernah dicatat ke log).
# Salin ISI JSON service account ke variabel di bawah, atau taruh file key
# DI LUAR folder project lalu isi path-nya — JANGAN simpan file JSON key di
# dalam repo (sudah di-ignore .gitignore, tetapi lebih aman tidak ada sama sekali).
# Biarkan kosong → otomatis memakai MOCK MODE tanpa biaya.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_VISION_LOCATION=
